PORT=3000
POSTGRES_USER=reservai
POSTGRES_DB=reservai
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://reservai:replace-with-a-local-password@localhost:5432/reservai
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_ORIGINS=http://localhost:8081,http://localhost:8082
NODE_ENV=development
# Dedicated disposable database for integration tests; must end in _test.
# TEST_DATABASE_URL=postgresql://reservai:your-local-password@localhost:5432/reservai_test
# Optional: enable Observe only with both credentials
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
